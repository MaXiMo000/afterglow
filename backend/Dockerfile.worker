# Analysis worker image. Separate from the API (SECURITY T4): its own image, user, network and egress policy.
# git >= 2.44 is required for --no-lazy-fetch (trixie ships 2.47). git only ever runs on bare clones.
FROM python:3.15-slim-trixie@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    AFTERGLOW_SCRATCH=/scratch AFTERGLOW_STORE=/store
WORKDIR /srv

# upgrade: Debian security fixes land before the python base image is rebuilt (Trivy gate, SECURITY.md).
RUN apt-get update \
 && apt-get upgrade -y --no-install-recommends \
 && apt-get install -y --no-install-recommends git ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY requirements.lock .
RUN pip install --require-hashes --no-deps -r requirements.lock \
 && useradd --system --uid 10002 --no-create-home --shell /usr/sbin/nologin worker \
 && mkdir -p /scratch /store && chown 10002:10002 /scratch /store

COPY core ./core
COPY worker ./worker

USER 10002:10002
ENTRYPOINT ["python", "-m", "worker"]
