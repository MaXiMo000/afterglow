# Egress proxy image: stdlib only, CONNECT to github.com:443 and nothing else (SECURITY T1, T4).
FROM python:3.15-slim-trixie@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv
# Debian security fixes land before the python base image is rebuilt (Trivy gate, SECURITY.md).
RUN apt-get update && apt-get upgrade -y --no-install-recommends && rm -rf /var/lib/apt/lists/*
RUN useradd --system --uid 10003 --no-create-home --shell /usr/sbin/nologin egress
COPY egress ./egress

USER 10003:10003
EXPOSE 3128
CMD ["python", "-m", "egress"]
