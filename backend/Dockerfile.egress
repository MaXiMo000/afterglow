# Egress proxy image: stdlib only, CONNECT to github.com:443 and nothing else (SECURITY T1, T4).
FROM python:3.12-slim-trixie@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv
RUN useradd --system --uid 10003 --no-create-home --shell /usr/sbin/nologin egress
COPY egress ./egress

USER 10003:10003
EXPOSE 3128
CMD ["python", "-m", "egress"]
