# Egress proxy image: stdlib only, CONNECT to github.com:443 and nothing else (SECURITY T1, T4).
FROM python:3.12-slim-trixie@sha256:2f17fc044b579bab302c2e8054d3a686e2cb9a83de48e70534b94cd8ebbe06a9

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv
RUN useradd --system --uid 10003 --no-create-home --shell /usr/sbin/nologin egress
COPY egress ./egress

USER 10003:10003
EXPOSE 3128
CMD ["python", "-m", "egress"]
