# API image. No git, no shell tools beyond the base image; runs as an unprivileged user on a read-only rootfs.
FROM python:3.12-slim-trixie@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /srv
# Debian security fixes land before the python base image is rebuilt (Trivy gate, SECURITY.md).
RUN apt-get update && apt-get upgrade -y --no-install-recommends && rm -rf /var/lib/apt/lists/*

COPY requirements.lock .
RUN pip install --require-hashes --no-deps -r requirements.lock \
 && useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin afterglow

COPY core ./core
COPY app ./app

USER 10001:10001
EXPOSE 8000
# Host "api" is always in AFTERGLOW_ALLOWED_HOSTS (deploy/compose.yaml); the public site name varies per deployment.
HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
  CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen(urllib.request.Request('http://127.0.0.1:8000/healthz', headers={'Host': 'api'}), timeout=2).status == 200 else 1)"]
CMD ["uvicorn", "app.asgi:app", "--host", "0.0.0.0", "--port", "8000", "--no-server-header", "--no-date-header", "--no-access-log"]
